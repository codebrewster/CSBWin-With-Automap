+    {
+      const AutoMapFloorActuator &a = s.actuators[i];
+      std::ostringstream o;
+      o << "{\"x\":" << a.x << ",\"y\":" << a.y << ",\"kind\":" << (int)a.kind << ",\"op\":" << (int)a.op << ",\"facing\":" << a.requiredFacing
+        << ",\"object\":" << ItemJson(sp, a.object) << ",\"gen\":" << JsonText(a.generatedMonsterName)
+        << ",\"genPic\":" << JsonText(a.hasGeneratedMonster ? sp.Plain(a.generatedKind.frontPicture, a.generatedKind.transparentColour) : "") << "}";
+      fprintf(f, "%s%s\n", i ? "," : "", o.str().c_str());
