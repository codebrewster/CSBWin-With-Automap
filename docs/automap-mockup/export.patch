+    sp.level = level;
+    std::vector<AutoMapMonsterChoice> types = AutoMapLevelReader_MonsterTypesOfLevel(level);
+    char path[512];
+    sprintf(path, "%s/level%d.json", dir, level);
+    FILE *f = fopen(path, "w");
+    fprintf(f, "{\"level\":%d,\"width\":%d,\"height\":%d,\"offsetX\":%d,\"offsetY\":%d,\"monsterTypes\":[", level, s.width, s.height, s.offsetX, s.offsetY);
+    for (size_t i = 0; i < types.size(); i++) { MONSTERDESC *md = &d.MonsterDescriptor[types[i].type]; ITEM12 *pics = &d.Item6414[md->uByte0]; int fp = 446 + pics->ITEM12_word0;
+      fprintf(f, "%s{\"type\":%d,\"name\":%s,\"frontPicture\":%d,\"front\":%s}", i ? "," : "", types[i].type, JsonText(types[i].name).c_str(), fp, JsonText(sp.Plain(fp, pics->uByte10 & 15)).c_str()); }
+    fprintf(f, "],\n\"cells\":[\n");
+    for (int y = 0; y < s.height; y++)
+      for (int x = 0; x < s.width; x++)
+      {
+        const AutoMapCellRecord &c = s.cells[(size_t)y * s.width + x];
