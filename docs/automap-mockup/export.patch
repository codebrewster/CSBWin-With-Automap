+    fprintf(f, "],\n\"links\":[\n");
+    for (size_t i = 0; i < s.links.size(); i++)
+    {
+      const AutoMapLink &l = s.links[i];
+      fprintf(f, "%s{\"sx\":%d,\"sy\":%d,\"dx\":%d,\"dy\":%d,\"wall\":%d,\"side\":%d,\"signal\":%d,\"once\":%d,\"delay\":%d,\"counter\":%d}\n", i ? "," : "",
+              l.srcX, l.srcY, l.dstX, l.dstY, l.srcIsWall, l.srcSide, (int)l.signal, l.onceOnly, l.delay, l.fromCounter);
+    }
+    fprintf(f, "],\"party\":[%d,%d,%d,%d]}\n", s.party.x, s.party.y, (int)s.party.facing, s.partyIsOnShownLevel);
+    fclose(f);
+    printf("export: level %d %dx%d, %zu links\n", level, s.width, s.height, s.links.size());
+  }
+}
