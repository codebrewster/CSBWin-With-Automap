+        o << "{\"x\":" << x << ",\"y\":" << y << ",\"kind\":" << (int)c.kind << ",\"out\":" << (c.isOutsideLevel ? 1 : 0)
+          << ",\"floor\":" << JsonText(sp.Plain(c.floorPicture, 10)) << ",\"floorPicture\":" << c.floorPicture
+          << ",\"door\":" << (int)c.doorState << ",\"ns\":" << (c.runsNorthSouth ? 1 : 0) << ",\"up\":" << (c.stairsLeadUp ? 1 : 0)
+          << ",\"pitHidden\":" << c.pitIsHidden << ",\"pitOpen\":" << c.pitIsOpen
+          << ",\"tele\":[" << c.teleporterDestLevel << "," << c.teleporterDestX << "," << c.teleporterDestY << "," << c.teleporterScope << "," << c.teleporterRotation << "," << c.teleporterFacingMode << "," << c.hasTeleporterTarget << "," << c.teleporterDestGlobalX << "," << c.teleporterDestGlobalY << "]"
+          << ",\"spinner\":[" << c.spinnerFacing << "," << c.spinnerRotation << "]"
+          << ",\"sides\":[";
+        for (int side = 0; side < 4; side++)
+        {
+          const AutoMapWallSide &w = c.wallSides[side];
+          o << (side ? "," : "") << "{\"pic\":" << JsonText(sp.Plain(w.picture, 10)) << ",\"picture\":" << w.picture
+            << ",\"writing\":" << w.hasWriting << ",\"functional\":" << w.functional << ",\"hidden\":" << w.hidden
+            << ",\"alcove\":" << w.isAlcove << ",\"portrait\":" << JsonText(sp.Portrait(w.portrait))
+            << ",\"text\":" << JsonText(w.text) << ",\"feature\":" << (int)w.feature << "}";
+        }
+        o << "],\"items\":[";
+        for (size_t i = 0; i < c.itemPictures.size(); i++) o << (i ? "," : "") << ItemJson(sp, c.itemPictures[i]);
+        o << "],\"alcove\":[";
+        for (size_t i = 0; i < c.alcoveContents.size(); i++) o << (i ? "," : "") << "{\"side\":" << c.alcoveContents[i].side << ",\"item\":" << ItemJson(sp, c.alcoveContents[i].item) << "}";
+        o << "],\"locks\":[";
+        for (size_t i = 0; i < c.wallLocks.size(); i++) o << (i ? "," : "") << "{\"side\":" << c.wallLocks[i].side << ",\"required\":" << c.wallLocks[i].required << ",\"item\":" << ItemJson(sp, c.wallLocks[i].object) << "}";
+        o << "],\"relays\":" << c.wallRelays.size() << "}";
+        fprintf(f, "%s%s\n", (x || y) ? "," : "", o.str().c_str());
+      }
+    fprintf(f, "],\n\"monsters\":[\n");
+    for (size_t i = 0; i < s.monsters.size(); i++)
+    {
+      const AutoMapMonsterRecord &m = s.monsters[i];
+      std::ostringstream o;
+      o << "{\"x\":" << m.x << ",\"y\":" << m.y << ",\"count\":" << m.memberCount << ",\"members\":[";
+      for (int k = 0; k < m.memberCount; k++)
